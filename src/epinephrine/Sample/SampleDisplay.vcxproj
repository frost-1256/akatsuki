  <!-- Epinephrine: fixed DriverVer. stampinf otherwise stamps the build time (HH.MM.SS.mmm) as the version,
       and for display drivers dxgkrnl reads the first field as the WDDM version: builds made after 21:00
       got 21.x and AddDevice failed with STATUS_DEVICE_CONFIGURATION_ERROR (0xC0000182). Keep it at 20.x. -->
  <PropertyGroup>
    <EpiDriverVersion Condition="'$(EpiDriverVersion)'==''">20.0.2.64</EpiDriverVersion>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Inf>
      <TimeStamp>$(EpiDriverVersion)</TimeStamp>
      <!-- UTC date: a local (JST) date is "postdated" for inf2cat between 00:00 and 09:00 (error 22.9.7) -->
      <DateStamp>$([System.DateTime]::UtcNow.ToString('MM/dd/yyyy'))</DateStamp>
    </Inf>
  </ItemDefinitionGroup>
